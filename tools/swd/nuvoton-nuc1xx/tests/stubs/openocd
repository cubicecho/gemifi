#!/usr/bin/env python3
"""Fake openocd for the offline tests. Touches no hardware.

Records its argv (one JSON list per line) in $STUB_CALLS, then acts on the -c commands:
  ISP chunk (set START/END/OUT): appends "addr value" lines read from $STUB_IMAGE at $STUB_BASE
      (0xFF past its end). With $STUB_FAIL_AT set it stops at that address once (while the file
      $STUB_FAIL_FLAG doesn't exist yet), prints a Bus Pirate-style error and exits 1.
      $STUB_FAIL_PARTIAL=1 also leaves half a line without a newline, like a killed session.
  gemifi_write_*: prints the GEMIFI WROTE marker.  gemifi_verify_aprom: prints GEMIFI VERIFIED,
      or fails when $STUB_VERIFY_FAIL=1.
"""
import json
import os
import re
import sys

args = sys.argv[1:]
with open(os.environ["STUB_CALLS"], "a") as f:
    f.write(json.dumps(args) + "\n")
cmds = [args[i + 1] for i, a in enumerate(args) if a == "-c" and i + 1 < len(args)]
text = "\n".join(cmds)
print("GEMIFI PDID 0x10012008")

m = re.search(r"set START (\d+); set END (\d+); set OUT \{(.*)\}", text)
if m:
    start, end, out = int(m.group(1)), int(m.group(2)), m.group(3)
    image = open(os.environ["STUB_IMAGE"], "rb").read()
    base = int(os.environ.get("STUB_BASE", "0x00100000"), 0)
    fail_at = os.environ.get("STUB_FAIL_AT")
    flag = os.environ.get("STUB_FAIL_FLAG", "")
    with open(out, "a") as f:
        for a in range(start, end, 4):
            if fail_at and a == int(fail_at, 0) and not os.path.exists(flag):
                open(flag, "w").close()
                if os.environ.get("STUB_FAIL_PARTIAL") == "1":
                    f.write(f"{a:08x} 12")
                print("Error: Sequence 5 not supported")
                print("Error: Failed to write memory at 0xffffffff")
                sys.exit(1)
            off = a - base
            word = (image[off:off + 4] + b"\xff" * 4)[:4] if 0 <= off < len(image) else b"\xff" * 4
            f.write(f"{a:08x} {int.from_bytes(word, 'little'):08x}\n")
            f.flush()
    sys.exit(0)

w = re.search(r"gemifi_write_isp_region (\w+) \S+ \S+ \{(.*)\}", text)
if w:
    print(f"GEMIFI WROTE {w.group(1)} {w.group(2)}")
if "gemifi_write_aprom" in text:
    print("GEMIFI WROTE aprom")
if "gemifi_verify_aprom" in text:
    if os.environ.get("STUB_VERIFY_FAIL") == "1":
        print("diff 0 address 0x00000010. Was 0x00 instead of 0x01")
        print("Error: checksum mismatch")
        sys.exit(1)
    print("GEMIFI VERIFIED aprom")
if "gemifi_read_config" in text:
    print("GEMIFI CONFIG0 0xff4fff7f")
    print("GEMIFI CONFIG1 0x0001f000")
sys.exit(0)
