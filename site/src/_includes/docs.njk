---
layout: base.njk
---
{#- A docs page: search and the tree on the left, the page, and its contents on the right (wide screens).
    The page is what the search indexes (data-pagefind-body), unless it says `searchable: false`. -#}
<div class="docs">
  <aside class="docs-side">
    <div class="docs-search" id="docs-search" role="search"></div>
    {% include "docs-nav.njk" %}
  </aside>
  <article class="docs-main"{% if searchable !== false %} data-pagefind-body{% endif %}>
    {% if crumb %}<p class="eyebrow{% if tone %} tone tone-{{ tone }}{% endif %}" data-pagefind-ignore>{{ crumb }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if lede %}<p class="docs-lede">{{ lede }}</p>{% endif %}
    {{ content | safe }}
    {% if source %}
    <p class="docs-source" data-pagefind-ignore>
      This page is <a href="{{ source }}" rel="noopener"><code>{{ sourceFile }}</code></a> in the repo,
      collected when the site is built. Fix it there.
    </p>
    {% endif %}
  </article>
  {%- set toc = doc.toc if doc else toc -%}
  {% if toc and toc.length > 1 %}
  <nav class="docs-toc" aria-label="On this page">
    <p class="docs-nav-head">On this page</p>
    <ul>
      {% for t in toc %}<li class="toc-{{ t.level }}"><a href="#{{ t.id }}">{{ t.text }}</a></li>{% endfor %}
    </ul>
  </nav>
  {% endif %}
</div>
<link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}" />
<script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
<script>
  // Results link under the site's path prefix; the index lives in _site/pagefind/ (eleventy.config.js).
  new PagefindUI({
    element: "#docs-search",
    baseUrl: {{ '/' | url | dump | safe }},
    showSubResults: true,
    showImages: false,
    translations: { placeholder: "Search the docs" },
  });
</script>
