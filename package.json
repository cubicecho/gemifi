{
  "name": "gemifi",
  "version": "0.18.0",
  "private": true,
  "description": "Release tooling only: semantic-release reads the commit log, picks the next version, writes CHANGELOG.md and tags it. Nothing here is published to npm.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubicecho/gemifi.git"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9"
  }
}
