{
  "name": "gemifi-updater",
  "private": true,
  "version": "0.32.1",
  "type": "module",
  "description": "gemifi web updater: device info, debug log and firmware upload over Web MIDI or Web Serial SysEx, and the first install on ESP chips.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esptool-js": "0.7.0",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "~19.2.0",
    "@types/w3c-web-serial": "1.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
